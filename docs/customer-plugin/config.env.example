# Documentation only; do not copy real secrets into this file.
CUSTOMER_MCP_ENABLED=false
CUSTOMER_MCP_RESOURCE=https://replace-before-connecting.invalid/api/mcp
CUSTOMER_MCP_ISSUER=https://replace-with-approved-provider.invalid/
