rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Server-owned deployment policy prevents bypassing a restricted pilot via
    // the public Firebase client API. Missing/malformed policy fails closed.
    function validAllowedUid(ids, index) {
      return ids.size() <= index || (ids[index] is string && ids[index].size() > 0 && ids[index].size() <= 128 && ids[index].matches('^[^/[:space:][:cntrl:]]+$'));
    }
    function deploymentAllowed() {
      let path = /databases/$(database)/documents/deploymentAccess/current;
      let policy = get(path).data;
      return exists(path) && (
        policy.get('mode', '') == 'standard'
        || (policy.get('mode', '') == 'restricted'
          && policy.get('allowedUids', null) is list
          && policy.allowedUids.size() > 0 && policy.allowedUids.size() <= 10
          && validAllowedUid(policy.allowedUids, 0) && validAllowedUid(policy.allowedUids, 1)
          && validAllowedUid(policy.allowedUids, 2) && validAllowedUid(policy.allowedUids, 3)
          && validAllowedUid(policy.allowedUids, 4) && validAllowedUid(policy.allowedUids, 5)
          && validAllowedUid(policy.allowedUids, 6) && validAllowedUid(policy.allowedUids, 7)
          && validAllowedUid(policy.allowedUids, 8) && validAllowedUid(policy.allowedUids, 9)
          && request.auth.uid in policy.allowedUids)
      );
    }
    function signedIn() {
      return request.auth != null && deploymentAllowed();
    }
    match /deploymentAccess/{policyId} {
      allow read, write: if false;
    }

    function membershipPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }

    function isMember(workspaceId) {
      return signedIn() && exists(membershipPath(workspaceId));
    }

    function memberRole(workspaceId) {
      return get(membershipPath(workspaceId)).data.role;
    }

    function canEdit(workspaceId) {
      return isMember(workspaceId) && memberRole(workspaceId) in ['owner', 'admin', 'member'];
    }

    function canAdmin(workspaceId) {
      return isMember(workspaceId) && memberRole(workspaceId) in ['owner', 'admin'];
    }

    // Orders are server-owned and permanent, including cancellations/refunds.
    // Check the document independently of project state: deleting/recreating a
    // parent must never unlock evidence that an existing order relies on.
    function projectIsEditable(workspaceId, projectId) {
      let project = /databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(projectId);
      return !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/companionDeletions/$(projectId))
        && !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(projectId)/orders/current)
        && (!exists(project) || (
          get(project).data.get('brief', null) == null
          && !(get(project).data.get('campaignStatus', '') in ['awaiting_payment', 'fulfillment'])
          && !(get(project).data.get('lifecycleStatus', '') in ['awaiting_payment', 'fulfillment'])
        ));
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if isMember(workspaceId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if canAdmin(workspaceId)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow read: if isMember(workspaceId);
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn()
          && memberId == request.auth.uid
          && resource.data.role == 'owner';
      }

      match /projects/{projectId} {
        allow read: if isMember(workspaceId);
        allow create: if canEdit(workspaceId)
          && !request.resource.data.keys().hasAny(['brief', 'briefRevision', 'archivedAt', 'sourceHistorySanitized', 'sourcesExpiredAt'])
          && projectIsEditable(workspaceId, projectId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.lifecycleStatus in ['evidence_review', 'approved', 'draft_ready', 'campaign_approved', 'awaiting_payment', 'fulfillment'];
        allow update: if canEdit(workspaceId)
          && !request.resource.data.keys().hasAny(['brief', 'briefRevision', 'archivedAt', 'sourceHistorySanitized', 'sourcesExpiredAt'])
          && projectIsEditable(workspaceId, projectId)
          && request.resource.data.workspaceId == resource.data.workspaceId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.lifecycleStatus in ['evidence_review', 'approved', 'draft_ready', 'campaign_approved', 'awaiting_payment', 'fulfillment'];
        allow delete: if canAdmin(workspaceId) && projectIsEditable(workspaceId, projectId);

        match /profiles/{profileId} {
          allow read: if isMember(workspaceId);
          allow create, update: if canEdit(workspaceId) && projectIsEditable(workspaceId, projectId);
          allow delete: if canAdmin(workspaceId)
            && projectIsEditable(workspaceId, projectId)
            && !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(projectId));
        }

        match /evidence/{evidenceId} {
          allow read: if isMember(workspaceId);
          allow create: if canEdit(workspaceId)
            && projectIsEditable(workspaceId, projectId)
            && request.resource.data.id == evidenceId
            && request.resource.data.url is string
            && request.resource.data.contentHash is string;
          allow update: if false;
          allow delete: if canAdmin(workspaceId)
            && projectIsEditable(workspaceId, projectId)
            && !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(projectId));
        }

        match /claims/{claimId} {
          allow read: if isMember(workspaceId);
          allow create, update: if canEdit(workspaceId)
            && projectIsEditable(workspaceId, projectId)
            && request.resource.data.id == claimId;
          allow delete: if canAdmin(workspaceId)
            && projectIsEditable(workspaceId, projectId)
            && !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(projectId));
        }

        match /campaigns/{campaignId} {
          allow read: if isMember(workspaceId);
          allow create, update: if canEdit(workspaceId) && projectIsEditable(workspaceId, projectId);
          allow delete: if canAdmin(workspaceId) && projectIsEditable(workspaceId, projectId);

          match /versions/{versionId} {
            allow read: if isMember(workspaceId);
            allow create: if canEdit(workspaceId) && projectIsEditable(workspaceId, projectId);
            allow update: if false;
            allow delete: if canAdmin(workspaceId)
              && projectIsEditable(workspaceId, projectId)
              && !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/projects/$(projectId));
          }
        }

        match /campaignApprovals/{approvalId} {
          allow read, write: if false;
        }

        match /orders/{orderId} {
          allow read: if isMember(workspaceId);
          allow write: if false;
        }

        match /directorySubmissions/{submissionId} {
          allow read: if isMember(workspaceId);
          allow write: if false;
        }

        match /jobs/{jobId} {
          allow read: if isMember(workspaceId);
          allow write: if false;
        }

        match /placements/{placementId} {
          allow read: if isMember(workspaceId);
          allow write: if false;
        }

        match /auditLogs/{logId} {
          allow read, write: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
